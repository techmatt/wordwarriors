# Dependencies
node_modules/

# Build output
dist/
*.local

# Playwright output: regenerated every run.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Screenshots a test or a session took for a look. Evidence belongs in a report,
# not in history; an image may be committed only where a test reads it back.
/tests/screenshots/

# Scratch space for one session's working files.
/scratch/

# Junctions into the Drive-synced folder (README, "Storage"). No trailing slash:
# git may see a junction as a link, not a directory.
# Full-resolution originals from `npm run art:gen` and Matt's photos (refs/); only
# game-sized PNGs are committed.
/art-originals
# Generated edge-tts audio, manifest and build cache from `npm run voice:build`.
/public/voice-gen

# Logs
*.log

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
# Git Bash's tools leave one where they crash (item 147: grep.exe.stackdump at the root).
*.stackdump

# Env
.env
.env.*

# NOTE: public/art/ (placeholder and real art) is committed on purpose. Voice is
# not: a fresh clone without public/voice-gen runs mute (captions still show)
# until it is linked or `npm run voice:build` fills it.
# Reports do not live in this repo — see CLAUDE.md, "Reports".
