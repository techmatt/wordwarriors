{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // DOM because the art tools (placeholders, generate, alts) run canvas code
    // inside a Playwright page; the rest of tools/ runs in node.
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "nodenext"
  },
  "include": ["tools"]
}
