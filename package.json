{
  "name": "wordwarriors",
  "private": true,
  "version": "0.0.1",
  "description": "A learn-to-read game for a four-year-old: phonics minigames that power flashy mock battles.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "art:placeholders": "tsx tools/art/placeholders.ts",
    "art:gen": "tsx tools/art/generate.ts",
    "art:alts": "tsx tools/art/alts.ts alts",
    "art:pick": "tsx tools/art/alts.ts pick",
    "voice:lines": "tsx tools/voice/compose.ts",
    "voice:build": "tsx tools/voice/build.ts",
    "voice:clip": "tsx tools/voice/addClip.ts",
    "voice:status": "tsx tools/voice/status.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "bank:audit": "tsx tools/phonics/audit.ts",
    "variety": "tsx tests/variety/simulate.ts",
    "test": "node --import tsx tests/fastLane.ts",
    "test:browser": "playwright test --grep-invert @slow --global-timeout=360000",
    "test:slow": "playwright test --grep @slow",
    "test:all": "npm run test:unit && playwright test",
    "test:pairs": "playwright test tests/pairs.spec.ts",
    "perf": "playwright test --config tests/perf/perf.config.ts",
    "shots": "playwright test --config tests/shots/shots.config.ts",
    "qa": "playwright test --config tests/qa/qa.config.ts",
    "voice:import": "tsx tools/voice/import.ts"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
